# Supabase Postgres connection string.
# Supabase → Project Settings → Database → Connection string → URI
# e.g. postgresql://postgres:YOUR-PASSWORD@db.xxxxx.supabase.co:5432/postgres
DATABASE_URL=""
NEXTAUTH_SECRET="amplygo-dev-secret-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# ---- OAuth (optional) — see SETUP-OAUTH.md ----
# The app runs fine without these. Fill them in to enable the features:
#  - GOOGLE_*  -> "Continue with Google" login  AND  the "Connect YouTube" button
#  - INSTAGRAM_* -> the "Connect Instagram" button
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# INSTAGRAM_CLIENT_ID=""
# INSTAGRAM_CLIENT_SECRET=""

# Admin login (defaults to admin@amplygo.com / password123 locally).
# Set a strong password in production.
# ADMIN_EMAIL="admin@amplygo.com"
# ADMIN_PASSWORD="change-me-in-production"
